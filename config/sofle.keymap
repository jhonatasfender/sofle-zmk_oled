/*
 * Layout de destino: ABNT2 (X11 `br`, pc105).
 *
 * O ZMK envia scancode, nao caractere: cada `&kp` passa pela tabela do ABNT2
 * antes de virar texto. Os comentarios abaixo mostram o que SAI na tela, nao o
 * nome do keycode. Equivalencias que valem lembrar ao editar:
 *
 *   GRAVE -> ' "        LBKT -> (agudo) (crase)   RBKT -> [ {
 *   SEMI  -> c-cedilha  SQT  -> (til) (circunf.)  BSLH -> ] }
 *   FSLH  -> ; :        INT1 -> / ? graus         NON_US_BSLH -> \ |
 *
 * As duas ultimas nao existem no ANSI: sao as teclas extras do ABNT2 (105
 * teclas). Sem elas, `/ ? \ |` ficam inalcancaveis no Sofle.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define NUM 3
#define ADJUST 4

/ {

   // Activate ADJUST layer by pressing raise and lower
    conditional_layers {
        compatible = "zmk,conditional-layers";
        adjust_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "default";
// ------------------------------------------------------------------------------------------------------------
// |   '   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   | AGUDO |
// |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
// |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   C,  |  TIL  |
// | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .   |   ;   | SHIFT |
//               | GUI | ALT  | CTRL | LOWER|  ENTER |  | SPACE | RAISE| CTRL  | ALT   | GUI  |
//
// As tres fileiras alfabeticas ja coincidem com o ABNT2: ... L C-cedilha (til),
// e ... , . ; na de baixo. O agudo entrou no canto superior direito porque sem
// ele nao se escreve `e-agudo`/`a-agudo`; o `&tog NUM` que estava ali foi para
// a camada RAISE.
            bindings = <
&kp GRAVE &kp N1 &kp N2   &kp N3   &kp N4    &kp N5                           &kp N6 &kp N7    &kp N8    &kp N9   &kp N0   &kp LBKT
&kp ESC   &kp Q  &kp W    &kp E    &kp R     &kp T                            &kp Y  &kp U     &kp I     &kp O    &kp P    &kp BSPC
&kp TAB   &kp A  &kp S    &kp D    &kp F     &kp G                            &kp H  &kp J     &kp K     &kp L    &kp SEMI &kp SQT
&kp LSHFT &kp Z  &kp X    &kp C    &kp V     &kp B      &kp C_MUTE &none      &kp N  &kp M     &kp COMMA &kp DOT  &kp FSLH &kp RSHFT
                 &kp LGUI &kp LALT &kp LCTRL &mo LOWER  &kp RET    &kp SPACE  &mo RAISE  &kp RCTRL &kp RALT  &kp RGUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        lower_layer {
            display-name = "lower";
// ------------------------------------------------------------------------------------------------------------
// |       |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
// |   '   |  1  |  2  |  3   |  4   |  5   |                   |  [   |  ]    |  {    |  }   |   \   |  F12  |
// |       |  !  |  @  |  #   |  $   |  %   |                   |  /   |  ?    |  ;    |  :   | AGUDO | CRASE |
// |       |  =  |  -  |  +   |  _   |  *   |        |  |       |  |   |  '    |  "    |      |       |       |
//               |     |      |      |      |        |  |       |      |       |       |      |
//
// `& ^ ( )` nao aparecem aqui: no ABNT2 saem com Shift na fileira de numeros da
// camada BASE, igual a um teclado de 105 teclas. O circunflexo e Shift+(til).
            bindings = <
&trans    &kp F1    &kp F2    &kp F3   &kp F4   &kp F5                      &kp F6           &kp F7    &kp F8   &kp F9    &kp F10         &kp F11
&kp GRAVE &kp N1    &kp N2    &kp N3   &kp N4   &kp N5                      &kp RBKT         &kp BSLH  &kp RBRC &kp PIPE  &kp NON_US_BSLH &kp F12
&trans    &kp EXCL  &kp AT    &kp HASH &kp DLLR &kp PRCNT                   &kp INT1         &kp LS(INT1) &kp FSLH &kp QMARK &kp LBKT     &kp LBRC
&trans    &kp EQUAL &kp MINUS &kp PLUS &kp UNDER &kp ASTRK &trans  &trans   &kp PIPE2        &kp GRAVE &kp LS(GRAVE) &trans &trans        &trans
                    &trans    &trans   &trans   &trans     &trans  &trans   &trans           &trans    &trans   &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        raise_layer {
            display-name = "raise";
// ------------------------------------------------------------------------------------------------------------
// | BTCLR | BT1  | BT2  |  BT3  |  BT4  |  BT5 |                |      |      |       |      |       |  NUM  |
// |       | INS  | PSCR | GUI   |       |      |                | PGUP | HOME |   ^   | END  | PSCR  |       |
// |       | ALT  | CTRL | SHIFT |       | CAPS |                | PGDN |   <- |   v   |  ->  |  DEL  | BKSPC |
// |       | UNDO | CUT  | COPY  | PASTE |      |      |  |      | PREV | PLAY | NEXT  |      |       |
//                |      |       |       |      |      |  |      |      |      |       |      |
            bindings = <
&bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4                  &trans    &trans    &trans   &trans    &trans  &tog NUM
&trans     &kp INS      &kp PSCRN    &kp K_CMENU  &trans       &trans                        &kp PG_UP &kp HOME  &kp UP   &kp END   &kp PSCRN  &trans
&trans     &kp LALT     &kp LCTRL    &kp LSHFT    &trans       &kp CLCK                      &kp PG_DN &kp LEFT  &kp DOWN &kp RIGHT &kp DEL &kp BSPC
&trans     &kp K_UNDO   &kp K_CUT    &kp K_COPY   &kp K_PASTE  &trans        &trans  &trans  &trans    &kp C_PREV       &kp C_PLAY_PAUSE &kp C_NEXT   &trans    &trans
                         &trans       &trans       &trans       &trans        &trans  &trans  &trans    &trans    &trans   &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        num_layer {
            display-name = "num";
// ------------------------------------------------------------------------------------------------------------
// Right-half numpad-style overlay; everything else is transparent to avoid conflicts
// |       |      |      |      |      |      |                   |      |      |      |      |      |       |
// |       |      |      |      |      |      |                   |      |  7   |  8   |  9   |   /  | BKSPC |
// |       |      |      |      |      |      |                   |      |  4   |  5   |  6   |   *  |   -   |
// |       |      |      |      |      |      |        |  |       |      |  1   |  2   |  3   |   +  |       |
//                |      |      |      |      |        |  |       |      |      |      |      |
//
// Os operadores usam os keycodes do teclado numerico (KP_*), que nao passam
// pela tabela do layout: `&kp FSLH` daria `;` no ABNT2, `&kp KP_DIVIDE` da `/`.
            bindings = <
&trans    &trans   &trans   &trans   &trans   &trans                         &trans    &trans   &trans   &trans   &trans   &trans
&trans    &trans   &trans   &trans   &trans   &trans                         &trans    &kp N7   &kp N8   &kp N9   &kp KP_DIVIDE &kp BSPC
&trans    &trans   &trans   &trans   &trans   &trans                         &trans    &kp N4   &kp N5   &kp N6   &kp KP_MULTIPLY &kp KP_MINUS
&trans    &trans   &trans   &trans   &trans   &trans     &trans   &trans    &trans    &kp N1   &kp N2   &kp N3   &kp KP_PLUS  &trans
                   &trans   &trans   &trans   &trans     &trans   &trans    &trans    &trans   &trans   &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        adjust_layer {
// ----------------------------------------------------------------------------------------------------------------------------
// | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
// | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
// |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
// |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
//                    |         |         |         |         |         | |      |      |      |       |      |
            display-name = "adjust";
            bindings = <
&bt BT_CLR        &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4                            &none &none &none &none &none &none
&ext_power EP_TOG &rgb_ug RGB_HUD &rgb_ug RGB_HUI &rgb_ug RGB_SAD &rgb_ug RGB_SAI &rgb_ug RGB_EFF                         &none &none &none &none &none &none
&none             &rgb_ug RGB_BRD &rgb_ug RGB_BRI &none           &none           &none                                   &none &none &none &none &none &none
&none             &none           &none           &none           &none           &none            &rgb_ug RGB_TOG &none  &none &none &none &none &none &none
                                  &none           &none           &none           &none            &none           &none  &none &none &none &none
            >;
        };

    };
};
